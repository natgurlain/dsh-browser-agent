# Every text file is LF in the working tree on every platform, Windows included. The
# installers, the release-fetch blocks shared by install/uninstall, the PowerShell scripts
# (UTF-8 BOM, LF) and the release checksums all depend on byte-exact files, and
# scripts/package-release.mjs packages the working tree as it is.
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
